@page
@model SM.APP.Pages.Admin.Servants.IndexModel
@{
    ViewData["Title"] = "Servants Management";
}
<div class="container mt-4" id="main-container">
    <partial name="_SuccessToastPartial" />
    <partial name="_LoadingPartial" />
    <partial name="_DeleteModalPartial" />
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h4 class="mb-0">
            Servants Management
            <span id="servant-counter" class="text-muted fw-normal"></span>
        </h4>
        <button class="btn btn-success" onclick="openCreateModal()">
            <i class="bi bi-plus-circle me-1"></i>
            Create Servant
        </button>
    </div>
    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <i class="bi bi-funnel me-1"></i>
            Filters
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small">
                        Servant Name
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0"
                               id="filterServantName"
                               placeholder="Search servant..."
                               onkeyup="filterServants()">
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label small">
                        Status
                    </label>
                    <select class="form-select"
                            id="filterStatus"
                            onchange="filterServants()">
                        <option value="all">All</option>
                        <option value="true" selected>Active Only</option>
                        <option value="false">Inactive Only</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <!-- Grid -->
    <div class="row g-4" id="servant-grid"></div>
</div>
<!-- Modal -->
<div class="modal fade" id="servantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="servantModalTitle">
                    Create Servant
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>
            <div class="modal-body p-4">
                <form id="servantForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">
                                Servant Name
                            </label>
                            <input class="form-control" id="ServantName" name="ServantName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">
                                Email
                            </label>
                            <input type="email" class="form-control" id="Email" name="Email" required />
                        </div>
                        <div class="col-md-6 password-field">
                            <label class="form-label fw-bold small">
                                Password
                            </label>
                            <input type="password" class="form-control" id="Password" name="Password" />
                        </div>
                        <div class="col-md-6 password-field">
                            <label class="form-label fw-bold small">
                                Confirm Password
                            </label>
                            <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">
                                Mobile
                            </label>
                            <input class="form-control" id="Mobile" name="Mobile" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Mobile 2</label>
                            <input class="form-control" id="Mobile2" name="Mobile2" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Classes</label>
                            <select class="form-select" id="drpServantClasses" name="drpServantClasses" multiple></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Roles</label>
                            <select class="form-select" id="drpRoles" name="drpRoles" multiple></select>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" name="isActive" checked>
                                <label class="form-check-label">
                                    Active
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit"
                                class="btn btn-primary px-4"
                                id="btnSaveServant">Create
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="servantEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="servantModalTitle">
                    Edit Servant
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>
            <div class="modal-body p-4">
                <form id="servantEditForm">
                    <input type="hidden" id="ServantID" name="ServantID" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">
                                Servant Name
                            </label>
                            <input class="form-control" id="EditServantName" name="EditServantName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">
                                Email
                            </label>
                            <input type="email" class="form-control" id="EditEmail" name="EditEmail" required disabled />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small">
                                Mobile
                            </label>
                            <input class="form-control" id="EditMobile" name="EditMobile" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Mobile 2</label>
                            <input class="form-control" id="EditMobile2" name="EditMobile2" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Classes</label>
                            <select class="form-select" id="drpEditServantClasses" name="drpEditServantClasses" multiple></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Roles</label>
                            <select class="form-select" id="drpEditRoles" name="drpEditRoles" multiple></select>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="EditIsActive" name="EditIsActive" checked>
                                <label class="form-check-label">
                                    Active
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit"
                                class="btn btn-primary px-4"
                                id="btnEditServant">Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        const apiBaseUrl = '@Services.SMConfigurationManager.ApiBase';
    </script>
    <script src="~/js/servants/servants-manage.js" asp-append-version="true"></script>
}